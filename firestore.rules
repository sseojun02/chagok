rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 차곡 본 데이터: 로그인한 본인 문서만
    match /chagok_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 30일 지난 완료 기록 보관함 (uid_연도)
    match /chagok_archive/{docId} {
      allow read, write: if request.auth != null && docId.matches(request.auth.uid + '_[0-9]{4}');
    }
  }
}
